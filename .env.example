# Public browsing only uses a prepared snapshot. No API key is required.
PORT=3000
HOST=127.0.0.1
# npm run data:prepare -- --source data/ep_data.db --output data/releases/baseline
# npm run data:promote -- --dataset data/releases/baseline
# Optional: use a prepared directory directly instead of data/current.json.
# DATASET_DIR=data/fixture
# Full .db downloads are enabled by default. Set 0 only to disable on a host.
# ENABLE_FULL_DATASET_DOWNLOAD=0
# OPENAI_API_KEY is used only by the separate offline ingestion commands.
