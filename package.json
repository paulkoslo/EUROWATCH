{
  "name": "eu-parliament-dashboard",
  "version": "1.2.0",
  "description": "Dashboard for EU Parliament data using public API",
  "main": "server.js",
  "private": true,
  "engines": { "node": ">=22.13.0 <23 || >=24" },
  "scripts": {
    "start": "node server.js",
    "build:render": "npm_config_build_from_source=sqlite3 npm ci --omit=dev && node -e \"require('sqlite3')\"",
    "preview:refresh": "node src/explorer/local-refresh.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format:check": "prettier --check server.js src/explorer src/data src/scripts/dataset.js test public/index.html public/app.js public/style.css eslint.config.mjs",
    "format": "prettier --write server.js src/explorer src/data src/scripts/dataset.js test public/index.html public/app.js public/style.css eslint.config.mjs",
    "check": "npm run lint && npm run format:check && npm test",
    "data:init": "node src/scripts/dataset.js init",
    "data:import": "node src/data/plenary-import.js",
    "data:refresh": "node src/data/refresh-run.js",
    "data:prepare": "node src/scripts/dataset.js prepare",
    "data:promote": "node src/scripts/dataset.js promote",
    "data:validate": "node src/scripts/dataset.js validate",
    "data:fixture": "node test/fixtures/create.js",
    "pipeline": "node src/pipeline/index.js",
    "step1": "node src/scripts/step-1-discover-date.js",
    "step2": "node src/scripts/step-2-fetch-html.js",
    "step3": "node src/scripts/step-3-parse-sitting.js",
    "step4": "node src/scripts/step-4-classify-topics.js",
    "step5": "node src/scripts/step-5-store-sitting.js",
    "bulk": "node src/pipeline/index.js --full",
    "demo-data": "node src/scripts/build-demo-data.js",
    "demo-data:full": "node src/scripts/build-demo-data.js --analytics"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.3.0",
    "proper-lockfile": "^4.1.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "axios": "^1.21.0",
    "cheerio": "^1.0.0",
    "cld3-asm": "^4.0.0",
    "cli-progress": "^3.12.0",
    "fflate": "^0.8.3",
    "franc": "^6.2.0",
    "langs": "^2.0.0",
    "openai": "^4.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.0.0"
  }
}
